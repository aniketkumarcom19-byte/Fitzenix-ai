<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fitzenix_ai.db" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store." />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fitzenix_ai.db" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.debug.store." />
        <exclude domain="sharedpref" path="com.google.firebase.appcheck.store." />
    </device-transfer>
</data-extraction-rules>
